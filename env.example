# --- required ---
GROQ_API_KEY=gsk_your_actual_key_here

# --- optional: fallback model if a per-role one below isn't set ---
GROQ_MODEL=llama-3.1-8b-instant

# --- optional: per-role model overrides (delete a line to fall back to GROQ_MODEL) ---
GROQ_MODEL_ACCURACY=llama-3.3-70b-versatile
GROQ_MODEL_LOGIC=llama-3.3-70b-versatile
GROQ_MODEL_COMPLETENESS=llama-3.1-8b-instant
GROQ_MODEL_ADJUDICATOR=llama-3.3-70b-versatile

# --- optional: evaluation scale switch, "5" or "10" (defaults to 5 if unset) ---
EVAL_SCALE=5
